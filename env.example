# =============================================================================
# ZgrWise Environment Configuration
# =============================================================================
# Copy this file to .env and update the values for your environment
# NEVER commit the actual .env file to version control!

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# PostgreSQL connection string
# Format: postgresql+psycopg://username:password@host:port/database
DATABASE_URL=postgresql+psycopg://zgr:zgrpass@db:5432/zgrwise

# Database connection pool settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
# Redis connection string
REDIS_URL=redis://redis:6379/0

# Redis connection pool settings
REDIS_MAX_CONNECTIONS=20
REDIS_RETRY_ON_TIMEOUT=true
REDIS_SOCKET_KEEPALIVE=true
REDIS_SOCKET_KEEPALIVE_OPTIONS=1,3,5

# =============================================================================
# AI SERVICE CONFIGURATION
# =============================================================================
# Google Gemini API (REQUIRED)
# Get your API key from: https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key-here
AI_MODEL=gemini-1.5-flash

# AI processing settings
AI_MAX_RETRIES=3
AI_TIMEOUT=30
AI_BATCH_SIZE=10

# =============================================================================
# EMBEDDINGS CONFIGURATION
# =============================================================================
# Sentence transformer model for embeddings
EMB_MODEL=BAAI/bge-small-en-v1.5
EMB_DIM=384
EMB_BATCH_SIZE=32

# =============================================================================
# API SECURITY (CRITICAL - CHANGE THESE!)
# =============================================================================
# API authentication key (REQUIRED)
# Generate a secure random string: openssl rand -hex 32
API_KEY=your-secure-api-key-here

# Secret key for JWT tokens and encryption (REQUIRED)
# Generate a secure random string: openssl rand -hex 32
SECRET_KEY=your-secret-key-here

# JWT settings
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================================
# CORS CONFIGURATION
# =============================================================================
# Allowed origins for CORS (comma-separated)
# For production, specify your actual domain(s)
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:8501

# CORS settings
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOW_HEADERS=*

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log format: json, text
LOG_FORMAT=json

# Enable request logging
LOG_REQUESTS=true

# =============================================================================
# MONITORING CONFIGURATION
# =============================================================================
# Enable Prometheus metrics
ENABLE_METRICS=true

# Metrics port
METRICS_PORT=9090

# Health check settings
HEALTH_CHECK_TIMEOUT=5
HEALTH_CHECK_INTERVAL=30

# =============================================================================
# EXPORT CONFIGURATION
# =============================================================================
# Obsidian export path
OBSIDIAN_EXPORT_PATH=./data/exports

# Export settings
EXPORT_BATCH_SIZE=100
EXPORT_RETENTION_DAYS=30

# =============================================================================
# WEB APPLICATION CONFIGURATION
# =============================================================================
# API base URL for web app
NEXT_PUBLIC_API_BASE=http://localhost:8000

# Web app settings
NEXT_PUBLIC_APP_NAME=ZgrWise
NEXT_PUBLIC_APP_VERSION=1.0.0

# =============================================================================
# PRODUCTION SETTINGS
# =============================================================================
# Environment: development, staging, production
ENVIRONMENT=development

# Enable debug mode (set to false in production)
DEBUG=true

# Enable auto-reload (set to false in production)
AUTO_RELOAD=true

# =============================================================================
# BACKUP CONFIGURATION
# =============================================================================
# Database backup settings
BACKUP_ENABLED=false
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
BACKUP_RETENTION_DAYS=7
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=

# =============================================================================
# RATE LIMITING
# =============================================================================
# API rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST=10

# =============================================================================
# CACHE CONFIGURATION
# =============================================================================
# Cache TTL settings (in seconds)
CACHE_DEFAULT_TTL=3600
CACHE_SEARCH_TTL=1800
CACHE_EMBEDDINGS_TTL=86400

# =============================================================================
# SSL/TLS CONFIGURATION (Production)
# =============================================================================
# SSL certificate paths (for production)
SSL_CERT_PATH=
SSL_KEY_PATH=

# Force HTTPS (set to true in production)
FORCE_HTTPS=false 