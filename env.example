# Database
DATABASE_URL=postgresql+psycopg://zgr:zgrpass@db:5432/zgrwise

# Redis
REDIS_URL=redis://redis:6379/0

# AI Service (Gemini)
GEMINI_API_KEY=your-gemini-api-key-here
AI_MODEL=gemini-1.5-pro

# Embeddings
EMB_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMB_DIM=384

# API Security (REQUIRED - change these!)
API_KEY=your-secure-api-key-here
SECRET_KEY=your-secret-key-here

# CORS
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:8501

# Export
OBSIDIAN_EXPORT_PATH=./data/exports

# API Base URL (for web app)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Gmail Integration (Optional)
GMAIL_OAUTH_JSON=./credentials/gmail-oauth.json
GMAIL_FROM_EMAIL=your-email@gmail.com
GMAIL_TO_EMAIL=your-email@gmail.com

# Google Drive Integration (Optional)
GOOGLE_DRIVE_CREDENTIALS=./credentials/google-drive-credentials.json
GOOGLE_DRIVE_FOLDER_ID=your-folder-id

# RSS Settings
RSS_PULL_INTERVAL=15  # minutes
DIGEST_SEND_TIME=08:00  # 24h format 